// Backend — build, test; on main: Docker Hub/ECR login, push to ECR, deploy to EKS.
//
// In Jenkins: Manage Credentials → add these IDs exactly:
//   aws-credentials   — AWS Credentials (ECR, STS)
//   docker-registry     — Username + password (docker login before build; use Docker Hub token or your registry user)
//   kubeconfig          — Secret file (kubectl context for the cluster)


pipeline {
    agent { label 'kapish' }
    tools {
        maven 'maven'
    }

    environment {
        AWS_REGION    = 'us-east-1'
        K8S_NAMESPACE = 'med-erp'

        ECR_REGISTRY  = '580222437000.dkr.ecr.us-east-1.amazonaws.com'
        AWS_DEFAULT_REGION = 'us-east-1'
        AWS_ECR_REPO_NAME = 'med-erp'

        GITOPS_REPO   = 'https://github.com/Kapish0879/med-erp-gitops.git'
        GITOPS_BRANCH = 'main'
    }

    options {
        timeout(time: 60, unit: 'MINUTES')
        buildDiscarder(
            logRotator(numToKeepStr: '20')
        )
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Environment Check') {
            steps {
                sh '''
                    set -e

                    echo "Java:"
                    java -version

                    echo "Maven:"
                    mvn -version

                    echo "Docker:"
                    docker --version

                    echo "AWS:"
                    aws --version

                    echo "Trivy:"
                    trivy --version

                
                '''
            }
        }

        stage('Build & Unit Test') {
            steps {
                sh '''
                    set -e

                    for svc in user-service product-service order-service; do

                        echo "====================================="
                        echo "Building $svc"
                        echo "====================================="

                        cd "$WORKSPACE/$svc"

                        mvn -B clean verify

                    done
                '''
            }

            post {
                always {
                    sh '''
                      echo "========================================"
                      echo "JUnit REPORTS"
                      echo "========================================"

                      find "$WORKSPACE" \
                      -path "*/target/surefire-reports/*.xml" \
                      -type f \
                      -print

                      '''
                    junit(
                        testResults: '**/target/surefire-reports/*.xml',
                        allowEmptyResults: false
                    )
                }
            }
        }

        stage('SonarQube Analysis') {
    steps {

        withSonarQubeEnv('SonarQube') {

            withCredentials([
                string(
                    credentialsId: 'sonar-token',
                    variable: 'SONAR_TOKEN'
                )
            ]) {

                sh '''
                    set -e

                    for svc in user-service product-service order-service; do

                        echo "====================================="
                        echo "SonarQube: $svc"
                        echo "====================================="

                        cd "$WORKSPACE/$svc"

                        mvn -B org.sonarsource.scanner.maven:sonar-maven-plugin:5.2.0.4988:sonar \
                        -Dsonar.projectKey="med-erp-$svc" \
                        -Dsonar.projectName="med-erp-$svc" \
                        -Dsonar.host.url="$SONAR_HOST_URL" \
                        -Dsonar.token="$SONAR_TOKEN"

                    done
                '''
            }
        }
    }
}

        stage('Quality Gate') {
            steps {

                timeout(time: 10, unit: 'MINUTES') {

                    waitForQualityGate(
                        abortPipeline: true
                    )
                }
            }
        }

        
       

        stage('Docker Build') {


            steps {

                sh '''
                    set -e

                    for svc in user-service product-service order-service; do

                        echo "====================================="
                        echo "Docker Build: $svc"
                        echo "====================================="

                        docker build -t ${ECR_REGISTRY}/${AWS_ECR_REPO_NAME}:${svc}-${BUILD_NUMBER} ./$svc
                        docker images

                    done
                '''
            }
        }

       stage('trivy image scanning') {

        steps {

            sh '''
                set -e

             for svc in user-service product-service order-service; do
                echo "====================================="
                TEMPDIR=/opt/temp-trivy \
                trivy image \
                --cache-dir /opt/trivy-cache \
                --scanners vuln \
                --severity HIGH,CRITICAL \
                --exit-code 0 \
                ${ECR_REGISTRY}/${AWS_ECR_REPO_NAME}:${svc}-${BUILD_NUMBER}

                done
            '''
        }
       }

        

         stage('Push Images to ECR') {
             steps {
                withCredentials([
              [$class: 'AmazonWebServicesCredentialsBinding',
               credentialsId: 'AWS-credentials']])
               {

                 sh '''
                     set -e

                     echo "Logging in to Amazon ECR..."

                     aws ecr get-login-password --region ${AWS_REGION} | \
                     docker login --username AWS --password-stdin \
                     ${ECR_REGISTRY}

                     for svc in user-service product-service order-service; do

                     IMAGE="${ECR_REGISTRY}/${AWS_ECR_REPO_NAME}:${svc}-${BUILD_NUMBER}"
                     echo "Pushing:"
                     echo "$IMAGE"

                     docker push "$IMAGE"

                     done
                     '''
               }
                }
            }


stage('Checkout GitOps Repository') {
    steps {
        dir('gitops') {

            withCredentials([
                string(
                    credentialsId: 'GITHUB-TOKEN',
                    variable: 'GIT_TOKEN'
                )
            ]) {
                sh '''
                    set -e

                    echo "========================================"
                    echo "Cloning GitOps Repository"
                    echo "========================================"

                    git clone \
                        https://${GIT_TOKEN}@github.com/Kapish0879/med-erp-gitops.git \
                        .

                    git checkout main
                    git pull origin main

                    git branch --show-current

                    git remote -v
                '''
            }
        }
    }
}

stage('Update Deployment Files') {
    steps {
        dir('gitops') {
            sh '''
                set -e

                 for svc in user-service product-service order-service; do

               
                echo "${svc} Deployment File"
                sed -i \
                "s|image: .*:${svc}-[0-9]*|image: ${ECR_REGISTRY}/${AWS_ECR_REPO_NAME}:${svc}-${BUILD_NUMBER}|" \
                k8s/deployments/${svc}-deployment.yaml

                done
                grep -R "image:" k8s/deployments/
            '''
        }
    }
}
        
}

    post {

        success {
            echo '''
========================================
 CI PIPELINE SUCCESS
========================================

Images pushed to ECR.

GitOps repository updated.

Argo CD should now synchronize
the new images to EKS.
'''
        }

        failure {
            echo '''
========================================
 CI PIPELINE FAILED
========================================

Check the failed stage above.
========================================
'''
        }

        always {
             // Remove all files from Jenkins workspace
                cleanWs()
             sh '''
            # Remove all images
            docker rmi -f $(docker images -aq) 2>/dev/null || true
             
             #display docker images
                docker images
             '''
        }
    }
}



