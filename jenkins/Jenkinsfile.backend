// Backend — build, test; on main: Docker Hub/ECR login, push to ECR, deploy to EKS.
//
// In Jenkins: Manage Credentials → add these IDs exactly:
//   aws-credentials   — AWS Credentials (ECR, STS)
//   docker-registry     — Username + password (docker login before build; use Docker Hub token or your registry user)
//   kubeconfig          — Secret file (kubectl context for the cluster)


pipeline {
    agent { label 'kapish' }
    tools {
        maven 'maven'
    }

    environment {
        AWS_REGION    = 'us-east-1'
        K8S_NAMESPACE = 'med-erp'

        ECR_REGISTRY  = ''
        IMAGE_TAG     = "${env.GIT_COMMIT ? env.GIT_COMMIT.take(8) : "b${env.BUILD_NUMBER}"}"

        GITOPS_REPO   = 'https://github.com/Kapish0879/med-erp-gitops.git'
        GITOPS_BRANCH = 'main'
    }

    options {
        timeout(time: 60, unit: 'MINUTES')
        buildDiscarder(
            logRotator(numToKeepStr: '20')
        )
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        // stage('Environment Check') {
        //     steps {
        //         sh '''
        //             set -e

        //             echo "Java:"
        //             java -version

        //             echo "Maven:"
        //             mvn -version

        //             echo "Docker:"
        //             docker --version

        //             echo "AWS:"
        //             aws --version

        //             echo "Trivy:"
        //             trivy --version

                
        //         '''
        //     }
        // }

        // stage('Build & Unit Test') {
        //     steps {
        //         sh '''
        //             set -e

        //             for svc in user-service product-service order-service; do

        //                 echo "====================================="
        //                 echo "Building $svc"
        //                 echo "====================================="

        //                 cd "$WORKSPACE/$svc"

        //                 mvn -B clean verify

        //             done
        //         '''
        //     }

        //     post {
        //         always {
        //             sh '''
        //               echo "========================================"
        //               echo "JUnit REPORTS"
        //               echo "========================================"

        //               find "$WORKSPACE" \
        //               -path "*/target/surefire-reports/*.xml" \
        //               -type f \
        //               -print

        //               '''
        //             junit(
        //                 testResults: '**/target/surefire-reports/*.xml',
        //                 allowEmptyResults: false
        //             )
        //         }
        //     }
        // }

        stage('SonarQube Analysis') {
    steps {

        withSonarQubeEnv('SonarQube') {

            withCredentials([
                string(
                    credentialsId: 'sonar-token',
                    variable: 'SONAR_TOKEN'
                )
            ]) {

                sh '''
                    set -e

                    for svc in user-service product-service order-service; do

                        echo "====================================="
                        echo "SonarQube: $svc"
                        echo "====================================="

                        cd "$WORKSPACE/$svc"

                        mvn -B org.sonarsource.scanner.maven:sonar-maven-plugin:5.2.0.4988:sonar \
                        -Dsonar.projectKey="med-erp-$svc" \
                        -Dsonar.projectName="med-erp-$svc" \
                        -Dsonar.host.url="$SONAR_HOST_URL" \
                        -Dsonar.token="$SONAR_TOKEN"

                    done
                '''
            }
        }
    }
}

        stage('Quality Gate') {
            steps {

                timeout(time: 10, unit: 'MINUTES') {

                    waitForQualityGate(
                        abortPipeline: true
                    )
                }
            }
        }

        // stage('OWASP Dependency Check') {
        //     steps {

        //         sh '''
