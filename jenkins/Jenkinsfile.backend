        stage('Docker Build') {


            steps {

                sh '''
                    set -e

                    for svc in user-service product-service order-service; do

                        echo "====================================="
                        echo "Docker Build: $svc"
                        echo "====================================="

                        docker build \
                          -t "$ECR_REGISTRY/med-erp/$svc:$IMAGE_TAG" \
                          "$WORKSPACE/$svc"

                    done
                '''
            }
        }

